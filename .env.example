# Общий секретный токен (сгенерируй: python3 -c "import secrets; print(secrets.token_hex(32))")
LOG_COLLECTOR_TOKEN=REPLACE_WITH_STRONG_TOKEN

# ── Только для нод ────────────────────────────────────────
LOG_NODE_NAME=node-1
LOG_COLLECTOR_URL=http://<PANEL_IP>:9876/ingest

# Папка на хосте, куда Xray пишет access.log
HOST_LOG_DIR=/var/log/remnanode
